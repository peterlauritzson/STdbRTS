{
  "name": "stdbrts-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "preview": "vite preview",
    "generate": "spacetime generate --lang typescript --out-dir src/bindings --module-path server --yes",
    "server:start": "spacetime start --listen-addr 127.0.0.1:3000 --data-dir .spacetime-dev --non-interactive",
    "server:publish": "spacetime publish --server http://127.0.0.1:3000 --module-path server --delete-data=never --yes stdbrts-playtest",
    "test": "npm run test:core && npm run test:client",
    "test:core": "cargo test --manifest-path server/core/Cargo.toml",
    "test:client": "node --import tsx --test tests/presentation.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "test:browser": "playwright test",
    "bot": "tsx scripts/bot.ts"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide": "^1.41.0",
    "spacetimedb": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "vite": "^7.3.6"
  }
}
