# Build-time configuration for `npm run build`. Vite loads this file for
# production builds only; `npm run dev` keeps using .env.local / the defaults.
#
# The host must be wss:// (not ws://). The deployed page is served over HTTPS
# and browsers refuse plaintext WebSockets from a secure page.
#
# Set VITE_STDB_DATABASE to the name you passed to `spacetime publish`.
VITE_STDB_HOST=wss://maincloud.spacetimedb.com
VITE_STDB_DATABASE=stdbrts-playtest
